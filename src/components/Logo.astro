<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 1060 170"
  width="1060"
  height="170"
  role="img"
  aria-labelledby="brand-title brand-description"
  style="display: block; width: 100%; max-width: 760px; height: auto;"
>
  <title id="brand-title">Yours and Mine Designs</title>
  <desc id="brand-description">
    Your gateway to ChatGPT API calls.
  </desc>

  <defs>
    <linearGradient
      id="brand-word-gradient"
      x1="240"
      y1="0"
      x2="570"
      y2="0"
      gradientUnits="userSpaceOnUse"
    >
      <stop offset="0%" stop-color="#14b8a6" />
      <stop offset="55%" stop-color="#2583f8" />
      <stop offset="100%" stop-color="#14305f" />
    </linearGradient>
  </defs>

  <!-- Brand -->
  <text
    x="24"
    y="82"
    font-family="Arial, Helvetica, sans-serif"
    font-weight="700"
    font-size="72"
    letter-spacing="-1.5"
  ><tspan fill="#14305f">Yours </tspan><tspan fill="url(#brand-word-gradient)">and Mine </tspan><tspan fill="#14305f">Designs</tspan></text>

  <!-- Tagline -->
  <text
    x="27"
    y="132"
    font-family="Arial, Helvetica, sans-serif"
    font-weight="400"
    font-size="27"
    letter-spacing="0.5"
    fill="#526580"
  >Your gateway to ChatGPT API calls</text>
</svg>
